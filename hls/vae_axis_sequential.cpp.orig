#include "vae_axis.hpp"

#include "vae_core.h"  // generated by hls4ml (train_vae.py)

namespace {

constexpr int kFeatureCount = 8;
using score_t = ap_ufixed<64, 32>;
// Exact difference of a 16-fractional-bit feature and a reconstruction with <= 16 fractional bits.
using diff_t = ap_fixed<27, 11>;

score_t reconstruction_score(const input_t x[kFeatureCount], const result_t recon[kFeatureCount]) {
    score_t sum = 0;
    for (int i = 0; i < kFeatureCount; ++i) {
#pragma HLS UNROLL
        const diff_t d = diff_t(x[i]) - diff_t(recon[i]);
        const ap_fixed<54, 22> sq = d * d;  // exact: 32 fractional bits
        sum += score_t(sq);
    }
    return sum;
}

}  // namespace

void vae_axis(hls::stream<vae_feature_beat_t>& s_axis_features,
              hls::stream<vae_score_beat_t>& m_axis_score) {
#pragma HLS INTERFACE axis port=s_axis_features register_mode=both
#pragma HLS INTERFACE axis port=m_axis_score register_mode=both
#pragma HLS INTERFACE ap_ctrl_none port=return

    static_assert(input_t::width == 25 && input_t::iwidth == 9,
                  "The feature stream carries signed fixed-point values with 16 fractional bits");
    static_assert(result_t::width - result_t::iwidth <= 16,
                  "Reconstruction must have at most 16 fractional bits for an exact score");

    input_t features[kFeatureCount];
#pragma HLS ARRAY_PARTITION variable=features complete
    result_t recon[kFeatureCount];
#pragma HLS ARRAY_PARTITION variable=recon complete
    ap_uint<4> valid_bytes = 0xf;
    bool last = false;

    for (int i = 0; i < kFeatureCount; ++i) {
#pragma HLS PIPELINE off
        const vae_feature_beat_t beat = s_axis_features.read();
        last = beat.last;
        if (last && i != kFeatureCount - 1) {
            return;  // early TLAST: drop the frame
        }
        valid_bytes &= beat.keep & beat.strb;
        features[i].range(24, 0) = beat.data.range(24, 0);
    }

    if (!last) {
        // Oversized frame: discard through its TLAST.
        do {
            last = s_axis_features.read().last;
        } while (!last);
        return;
    }
    if (valid_bytes != 0xf) {
        return;
    }

    vae_core(features, recon);
    const score_t score = reconstruction_score(features, recon);

    vae_score_beat_t result;
    result.data = score.range(63, 0);
    result.keep = 0xff;
    result.strb = 0xff;
    result.last = 1;
    m_axis_score.write(result);
}
